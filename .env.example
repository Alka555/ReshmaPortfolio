# # ==============================================================================
# # PROJECT BLUEFRAME — PRODUCTION ENVIRONMENT VARIABLES
# # Reshma M — Premium Personal Creative Platform
# # ==============================================================================
# # Copy this file to .env.local for local development
# # Configure the same variables in Vercel Dashboard → Settings → Environment Variables
# # ==============================================================================

# # ------------------------------------------------------------------------------
# # SUPABASE — Required
# # Get these from: https://supabase.com/dashboard → Project → API Settings
# # ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# # NEVER expose this key publicly. Server Actions / Edge Functions only.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# # ------------------------------------------------------------------------------
# # SITE CONFIGURATION — Required
# # ------------------------------------------------------------------------------
# # Local: http://localhost:3000
# # Production: https://reshmam.com (your custom domain)
# NEXT_PUBLIC_SITE_URL=https://reshmam.com

# # ------------------------------------------------------------------------------
# # EMAIL NOTIFICATIONS — Optional (Resend)
# # Get API key from: https://resend.com/api-keys
# # ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key
# ADMIN_NOTIFICATION_EMAIL=hello@reshmam.com

# # ------------------------------------------------------------------------------
# # ANALYTICS — Optional (Vercel Analytics, enabled in Vercel Dashboard)
# # No env var needed — enable directly in Vercel project settings.
# # ------------------------------------------------------------------------------

# # ------------------------------------------------------------------------------
# # ERROR TRACKING — Optional (Sentry)
# # Get from: https://sentry.io
# # ------------------------------------------------------------------------------
# # NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# # SENTRY_AUTH_TOKEN=your-sentry-auth-token
# # SENTRY_ORG=your-sentry-org
# # SENTRY_PROJECT=reshma-m-portfolio

# # ------------------------------------------------------------------------------
# # GOOGLE VERIFICATION — Optional (SEO)
# # ------------------------------------------------------------------------------
# # NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-search-console-token

NEXT_PUBLIC_DISABLE_SUPABASE=true